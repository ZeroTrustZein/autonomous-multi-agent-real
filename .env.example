# Autonomous Multi-Agent Real Estate Underwriting & Simulation Engine
# Environment Configuration

APP_ENV=development
LOG_LEVEL=INFO

# Simulation Parameters
DEFAULT_MONTE_CARLO_ITERATIONS=1000
DEFAULT_RANDOM_SEED=42

# Market Data Settings
DATA_CACHE_DIR=./data_cache
STORAGE_PATH=./deals_data

# Underwriting Hurdle Defaults
MIN_ACCEPTABLE_IRR=0.14
MIN_ACCEPTABLE_DSCR=1.25
TARGET_EQUITY_MULTIPLE=1.80
